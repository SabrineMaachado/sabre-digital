---
import { site, hasTracking } from '../config/site';
import logo from '../assets/logo-dakar-completo.svg?raw';

const base = Astro.url.pathname === '/' ? '' : '/';
const year = new Date().getFullYear();
---
<footer class="foot dark" data-theme="dark">
  <div class="wrap foot-in">
    <a href={`${base}#topo`} class="logo logo--foot" aria-label="Dakar Digital, voltar ao início"><Fragment set:html={logo} /></a>
    <nav class="foot-nav" aria-label="Rodapé">
      <a href={`${base}#metodo`}>Método</a>
      <a href={`${base}#ofertas`}>Ofertas</a>
      <a href={`${base}#duvidas`}>Dúvidas</a>
      <a href={`${base}#contato`}>Contato</a>
      <a href="/politica-de-privacidade/">Política de privacidade</a>
      {hasTracking && <button type="button" data-consent-open>Preferências de cookies</button>}
    </nav>
    <div>
      <small>© {year} {site.name}{site.cnpj && ` · CNPJ ${site.cnpj}`}</small>
      <small>Seus dados são tratados conforme a LGPD.</small>
    </div>
  </div>
</footer>
