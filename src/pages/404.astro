---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada — Dakar Digital" noindex>
  <section class="sec dark page-hero" data-theme="dark">
    <div class="gl gl-a"></div>
    <div class="gl gl-b"></div>
    <div class="grain"></div>
    <div class="wrap stack g-28">
      <span class="eb">Erro 404</span>
      <h1 class="h1">Esse caminho <span class="acc">não existe.</span></h1>
      <p class="lead">A página que você procurou não está aqui. O caminho até o cliente começa pela página inicial.</p>
      <div class="ctas">
        <a href="/" class="btn btn-p">Voltar ao início</a>
      </div>
    </div>
  </section>
</Base>
